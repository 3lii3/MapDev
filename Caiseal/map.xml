<map proto="1.5.0">
<include id="gapple-kill-reward"/>
<name>Caiseal</name>
<version>1.0.0</version>
<objective>Capture the enemy team's wool!</objective>
<created>2024-11-18</created>
<authors>
    <author uuid="4d6ecfd1-2e0e-49b6-83c6-e230efe448d4"/> <!-- 3lii3 -->
</authors>
<contributors>
    <contributor uuid="63ddf58a-ba2c-4d39-8481-6358bb46c63a" contribution="XML - Base XML"/> <!-- samschaap -->
    <contributor uuid="6863869b-4b8c-4445-b778-a8e016775ae4" contribution="XML - Gap gen"/> <!-- samschaap -->
</contributors>
<teams>
    <team id="red-team" color="dark red" max="8">Red</team>
    <team id="blue-team" color="blue" max="8">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="stone sword"/>
        <item slot="1" unbreakable="true" material="bow"/>
        <item slot="28" amount="24" material="arrow"/>
        <item slot="2" unbreakable="true" enchantment="efficiency" material="iron pickaxe"/>
        <item slot="3" unbreakable="true" enchantment="efficiency" material="iron axe"/>
        <item slot="30" unbreakable="true" material="iron spade"/>
        <item slot="4" amount="64" material="wood"/>
        <item slot="5" amount="48" material="glass"/>
        <item slot="8" material="golden apple"/>
        <helmet unbreakable="true" team-color="true" material="leather helmet"/>
        <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
        <leggings unbreakable="true" enchantment="protection projectile" material="chainmail leggings"/>
        <boots unbreakable="true" team-color="true" material="leather boots"/>
        <effect duration="3s" amplifier="255">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <default>
        <region>
            <cylinder base="50.5,35,0.5" radius="0.5" height="0"/>
        </region>
    </default>
    <spawn team="red-team" kit="spawn-kit">
        <region yaw="-45">
            <point>-23.5,15,-55.5</point>
        </region>
    </spawn>
    <spawn team="blue-team" kit="spawn-kit">
        <region yaw="135">
            <point>24.5,15,56.5</point>
        </region>
    </spawn>
</spawns>
<filters>
    <all id="only-red-wr">
        <team id="only-red">red-team</team>
        <material>web</material>
    </all>
    <all id="only-blue-wr">
        <team id="only-blue">blue-team</team>
        <material>web</material>
    </all>
</filters>
<regions>
    <union id="spawns">
        <union id="red-spawn">
            <rectangle min="-11,-51" max="-27,-59"/>
            <rectangle min="-19,-35" max="-27,-59"/>
        </union>
        <union id="blue-spawn">
            <rectangle min="12,52" max="28,60"/>
            <rectangle min="20,36" max="28,60"/>
        </union>
    </union>
    <union id="wool-rooms">
        <rectangle id="red-wool-room" min="35,-51" max="53,-60"/> <!-- Blue capture, Red defend -->
        <rectangle id="blue-wool-room" min="-34,51" max="-52,61"/> <!-- Red capture, Blue defend -->
    </union>
    <union id="victory-monuments">
        <circle center="21.5,53.5" radius="1.5"/>
        <circle center="-20.5,-52.5" radius="1.5"/>
    </union>
    <negative id="void-area">
        <union id="bridgeable-area">
            <rectangle min="-32,-8" max="-11,-27"/> <!-- Red -->
            <rectangle min="-15,9" max="-32,32"/>
            <rectangle min="-15,-16" max="-11,-27"/>
            <rectangle min="5,-35" max="16,-43"/>
            <rectangle min="-32,-8" max="33,9"/> <!-- Mid -->
            <rectangle min="33,9" max="12,28"/> <!-- Blue -->
            <rectangle min="16,-8" max="33,-31"/>
            <rectangle min="16,17" max="12,28"/>
            <rectangle min="-4,36" max="-15,44"/>
        </union>
    </negative>
    <union id="gapple-spawner">
        <cylinder id="gap-radius" base="0.5,17,0.5" radius="5" height="3"/>
        <cuboid id="gapple-spawner-protection" min="-1,16,-1" max="1,19,1"/>
        <point id="gap-spawner-point">0.5,17,0.5</point>
    </union>
    <apply enter="only-red" region="red-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply enter="only-red" region="blue-wool-room" message="You may not enter your own wool room!"/>
    <apply enter="only-blue" region="red-wool-room" message="You may not enter your own wool room!"/>
    <apply block="only-red-wr" region="blue-wool-room" message="You may not modify the wool room!"/>
    <apply block="only-blue-wr" region="red-wool-room" message="You may not modify the wool room!"/>
    <apply enter="never" region="victory-monuments" message="You may not obstruct the victory monuments!"/>
    <apply block="never" region="spawns" message="You may not modify the spawn area!"/>
    <apply block="never" region="gapple-spawner-protection" message="You may not break the spawner!"/>
    <apply block="deny(void)" region="void-area" message="You may not modify the void area!"/>
</regions>
<spawners>
    <spawner spawn-region="gap-spawner-point" player-region="gap-radius" delay="8s">
        <item amount="1" material="golden apple"/>
    </spawner>
</spawners>
<wools craftable="false">
    <wool team="red-team" color="magenta" location="-48,25,56">
        <monument>
            <block>-21,16,-53</block>
        </monument>
    </wool>
    <wool team="blue-team" color="cyan" location="48,25,-56">
        <monument>
            <block>21,16,53</block>
        </monument>
    </wool>
</wools>
<toolrepair>
    <tool>stone sword</tool>
    <tool>bow</tool>
    <tool>arrow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
</toolrepair>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>leather boots</item>
    <item>string</item>
    <item>flint</item>
    <item>gravel</item>
    <item>dirt</item>
    <item>stained clay</item>
    <item>log 2</item>
</itemremove>
<block-drops>
    <rule>
        <filter>
            <material>wood</material>
        </filter>
        <drops>
            <item chance="0" material="wood"/>
        </drops>
    </rule>
</block-drops>
<itemkeep>
    <item>wood</item>
    <item>glass</item>
    <item>golden apple</item>
    <item>arrow</item>
</itemkeep>
<kill-rewards>
    <kill-reward>
        <item amount="16" material="wood"/>
        <item amount="16" material="glass"/>
        <item amount="8" material="arrow"/>
    </kill-reward>
</kill-rewards>
<maxbuildheight>35</maxbuildheight>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>