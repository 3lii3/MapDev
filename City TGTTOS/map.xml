<map proto="1.5.0">
<name>City TGTTOS</name>
<version>1.0.5</version>
<objective>Capture the enemy team's wool at the otherside!</objective>
<created>2025-05-28</created>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="4d6ecfd1-2e0e-49b6-83c6-e230efe448d4"/> <!-- 3lii3 -->
</authors>
<teams>
    <team id="blue" color="blue" max="5">Blue</team>
    <team id="red" color="dark red" max="5">Red</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="wooden sword" enchantment="knockback"/>
        <item slot="1" material="wool" team-color="true" amount="64"/>
        <item slot="2" unbreakable="true" material="shears">
            <enchantment level="3">efficiency</enchantment>
        </item>
        <item slot="8" material="golden apple"/>
        <helmet unbreakable="true" team-color="true" material="leather helmet">
            <enchantment level="2">protection</enchantment>
        </helmet>
        <chestplate unbreakable="true" team-color="true" material="leather chestplate">
            <enchantment level="2">protection</enchantment>
        </chestplate>
    </kit>
</kits>
<spawns>
    <default yaw="-180" pitch="90">
        <regions>
            <point>0.5,50,32.5</point>
        </regions>
    </default>
    <spawn team="blue" kit="spawn-kit" pitch="0" yaw="0">
        <regions>
            <point>7.5,20,0.5</point>
        </regions>
    </spawn>
    <spawn team="red" kit="spawn-kit" pitch="0" yaw="0">
        <regions>
            <point>-6.5,20,0</point>
        </regions>
    </spawn>
</spawns>
<wools craftable="false">
    <wool team="red" color="light blue" location="8,29,100">
        <monument>
            <block>-7,32,16</block>
        </monument>
    </wool>
    <wool team="blue" color="magenta" location="-8,29,100">
        <monument>
            <block>7,32,16</block>
        </monument>
    </wool>
</wools>
<filters>
    <all id="player-placed">
        <region id="build-area"/>
        <material>wool</material>
    </all>
    <team id="only-blue">blue</team>
    <team id="only-red">red</team>

    <any id="in-launch-pad">
        <region id="launch-pad"/>
    </any>
</filters>
<spawners>
    <spawner spawn-region="lb-wool-spawn" player-region="lb-wool-spawn" max-entities="16" min-delay="2s" max-delay="10s" filter="only-red">
        <item amount="1" material="light blue wool"/>
    </spawner>
    <spawner spawn-region="mg-wool-spawn" player-region="mg-wool-spawn" max-entities="16" min-delay="2s" max-delay="10s" filter="only-blue">
        <item amount="1" material="magenta wool"/>
    </spawner>

    <spawner spawn-region="gap-spawner-1" player-region="gap-spawner-1" max-entities="16" min-delay="6s" max-delay="10s">
        <item amount="1" material="golden apple"/>
    </spawner>
    <spawner spawn-region="gap-spawner-2" player-region="gap-spawner-2" max-entities="16" min-delay="6s" max-delay="10s">
        <item amount="1" material="golden apple"/>
    </spawner>
</spawners>
<actions>
    <action id="launch-player" scope="player">
        <velocity x="0" y="1.5" z="0"/>
    </action>

    <trigger filter="in-launch-pad" action="launch-player" scope="player"/>
</actions>
<regions>
    <cuboid id="lb-wool-spawn" min="10,29,99" max="8,31,101"/>
    <cuboid id="mg-wool-spawn" min="-7,29,99" max="-9,31,101"/>

    <cuboid id="launch-pad" min="-13,21,31" max="14,23,35"/>

    <block id="gap-spawner-1">7,23,16</block>
    <block id="gap-spawner-2">-7,23,16</block>
    
    <union id="wool-protection">
        <cuboid id="lb-wool-protection" min="-10,31,20" max="-3,50,13"/>
        <cuboid id="mg-wool-protection" min="4,31,20" max="11,50,13"/>
    </union>

    <union id="spawn-protection">
        <rectangle id="blue-protection" min="-13,-3" max="-1,4"/>
        <rectangle id="red-protection" min="1,-3" max="13,4"/>
    </union>

    <negative id="outside-build-area">
        <union id="build-area">
            <cuboid min="-13,17,5" max="0,30,30"/>
            <cuboid min="1,17,5" max="14,30,30"/>
            <cuboid min="-13,27,36" max="14,40,96"/>
            <cuboid min="-1,23,15" max="1,26,18"/>
        </union>
    </negative>
    
    <apply block="never" region="wool-protection" message="Wool can only be placed in monument!"/>
    <apply enter="only-red" block="never" region="lb-wool-protection" message="You can only enter your wool monument's region!"/>
    <apply enter="only-blue" block="never" region="mg-wool-protection" message="You can only enter your wool monument's region!"/>
    <apply block="player-placed" message="You can only use/destroy players wool!"/>
    <apply block="deny(outside-build-area)" message="You may not build outside building constraints!"/>
    <apply enter="only-blue" region="blue-protection" message="You may not enter the opponent's spawn!"/>
    <apply enter="only-red" region="red-protection" message="You may not enter the opponent's spawn!"/>
    <apply block="never" region="spawn-protection" message="You may not modify the spawns!"/>
</regions>
<itemremove>
    <item>red wool</item>
    <item>yellow wool</item>
    <item>blue wool</item>
    <item>golden apple</item>
    <item>wooden sword</item>
</itemremove>
<toolrepair>
    <item>leather chestplate</item>
    <item>leather helmet</item>
    <item>shears</item>
</toolrepair>
<hunger>
    <depletion>off</depletion>
</hunger>
<difficulty>hard</difficulty>
</map>